{
  "name": "iazap-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "IAZAP WhatsApp sidecar — Baileys + pipeline + MLX ReplyEngine over Unix socket",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/pipeline/*.test.ts",
    "smoke:pipeline": "tsx scripts/smoke-pipeline.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
